#!/bin/bash
set -euo pipefail
# shellcheck disable=SC1091
source /usr/share/yunohost/helpers

#=================================================
# RETRIEVE ARGUMENTS
#=================================================
app=$YNH_APP_INSTANCE_NAME

domain=$(ynh_app_setting_get --app="$app" --key=domain)
path=$(ynh_app_setting_get --app="$app" --key=path)
init_main_permission=$(ynh_app_setting_get --app="$app" --key=init_main_permission)
use_elasticsearch=$(ynh_app_setting_get --app="$app" --key=use_elasticsearch)

#=================================================
# CHECKS & PREP
#=================================================
ynh_print_info --message="Installing $app on $domain$path"

# Enforce subdomain root
if [[ "$path" != "/" ]]; then
  ynh_die --message="This draft package only supports installs at path=/ (use a dedicated subdomain)."
fi

# Basic sanity checks
ynh_webpath_available --domain="$domain" --path_url="$path"
ynh_webpath_register --app="$app" --domain="$domain" --path_url="$path"

#=================================================
# ADD ZAMMAD APT REPO (packager.io) & INSTALL
#=================================================
ynh_script_progression --message="Adding Zammad APT repository and installing packages" --time --weight=10

# Create a keyring for packager.io
install -d -m 0755 /usr/share/keyrings
curl -fsSL https://dl.packager.io/srv/zammad/zammad/key | gpg --dearmor -o /usr/share/keyrings/zammad-archive-keyring.gpg

cat >/etc/apt/sources.list.d/zammad.list <<'EOF'
deb [signed-by=/usr/share/keyrings/zammad-archive-keyring.gpg] https://dl.packager.io/srv/zammad/zammad/stable/debian 12 main
EOF

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends zammad libimlib2 curl ca-certificates

# Disable upstream NGINX vhost to avoid conflicts with YunoHost's NGINX layout
rm -f /etc/nginx/sites-enabled/zammad.conf || true
rm -f /etc/nginx/sites-available/zammad.conf || true
systemctl reload nginx || true

# Ensure services are enabled (zammad aggregates web/worker/websocket)
systemctl enable --now zammad
systemctl enable --now zammad-web
systemctl enable --now zammad-worker
systemctl enable --now zammad-websocket

#=================================================
# NGINX SETUP (YunoHost)
#=================================================
ynh_script_progression --message="Configuring NGINX" --time --weight=5

ynh_add_nginx_config

#=================================================
# PERMISSIONS
#=================================================
ynh_script_progression --message="Setting permissions" --time --weight=3

ynh_permission_update --permission "main" --add "all_users" --url "$path"
if [[ "$init_main_permission" == "visitors" ]]; then
  ynh_permission_update --permission "main" --add "visitors"
fi

#=================================================
# OPTIONAL: ELASTICSEARCH (external recommended)
#=================================================
if [[ "${use_elasticsearch}" == "1" || "${use_elasticsearch}" == "true" ]]; then
  ynh_print_warn --message="This draft expects an *external* Elasticsearch >=7.8,<9. After install, set ES URL and rebuild the index from CLI: 
  zammad run rails r \"Setting.set('es_url','http://<es-host>:9200')\" 
  zammad run rake zammad:searchindex:rebuild"
fi

#=================================================
# POST-INSTALL HINTS
#=================================================
ynh_print_info --message="Zammad installed. Open https://${domain} to run the initial setup wizard (create the admin, email channels, etc.)."
