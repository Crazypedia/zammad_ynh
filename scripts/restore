#!/bin/bash
set -euo pipefail
source /usr/share/yunohost/helpers

# Expect two files in $YNH_BACKUP_DIR: *_zammad_db.psql.gz and *_zammad_files.tar.gz
BACKUP_DIR=$YNH_BACKUP_DIR
DB_DUMP=$(ls "$BACKUP_DIR"/*_zammad_db.psql.gz 2>/dev/null | tail -n1 || true)
FILES_TAR=$(ls "$BACKUP_DIR"/*_zammad_files.tar.gz 2>/dev/null | tail -n1 || true)

[[ -f "$DB_DUMP" && -f "$FILES_TAR" ]] || ynh_die --message="Missing Zammad backup artifacts in $BACKUP_DIR"

systemctl stop zammad zammad-web zammad-worker zammad-websocket || true

# Stage files into the default restore dir used by upstream scripts
install -d -m 0750 /var/tmp/zammad/restore
cp -f "$DB_DUMP" /var/tmp/zammad/restore/
cp -f "$FILES_TAR" /var/tmp/zammad/restore/

# Purge storage to avoid stale files (upstream recommendation)
rm -rf /opt/zammad/storage/* || true

/opt/zammad/contrib/backup/zammad_restore.sh

systemctl start zammad zammad-web zammad-worker zammad-websocket
