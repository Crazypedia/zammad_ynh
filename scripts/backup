#!/bin/bash
set -euo pipefail
source /usr/share/yunohost/helpers

BACKUP_DIR=$YNH_BACKUP_DIR
mkdir -p "$BACKUP_DIR"

# Use Zammad's built-in package backup script. Create a temp dir to stage
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# Ensure config exists (first run only)
if [[ -f /opt/zammad/contrib/backup/config.dist && ! -f /opt/zammad/contrib/backup/config ]]; then
  cp /opt/zammad/contrib/backup/config.dist /opt/zammad/contrib/backup/config
fi

# Stop services for a clean snapshot, then back up
systemctl stop zammad zammad-web zammad-worker zammad-websocket
/opt/zammad/contrib/backup/zammad_backup.sh

# Copy the two artifacts into the YunoHost backup dir if present
for f in /var/tmp/zammad/*_zammad_db.psql.gz /var/tmp/zammad/*_zammad_files.tar.gz; do
  [[ -f "$f" ]] && cp -f "$f" "$BACKUP_DIR"/
done

# Also keep minimal app nginx conf for completeness
cp -a /etc/nginx/conf.d/*/*.d/zammad.conf "$BACKUP_DIR"/ 2>/dev/null || true

systemctl start zammad zammad-web zammad-worker zammad-websocket
